# R1/DME broker
DME_BASE_URL=http://127.0.0.1:9990
INFO_TYPE_ID=oran-health-monitor-kpm-v1
EVIDENCE_PRODUCER_ID=health-evidence-producer-1

# Bind locally; advertise an address reachable by DME and rApps.
EVIDENCE_API_BIND_HOST=127.0.0.1
EVIDENCE_API_PORT=9991
EVIDENCE_API_BASE_URL=http://127.0.0.1:9991
AUTO_REGISTER_WITH_DME=true
REGISTRATION_RETRY_S=5
REGISTRATION_RECONCILE_S=30

# Use memory for tests only. Deployment should use postgres.
EVIDENCE_BACKEND=memory
EVIDENCE_MEMORY_LIMIT=10000
# EVIDENCE_BACKEND=postgres
# EVIDENCE_DATABASE_URL=postgresql://evidence:change-me@postgres:5432/evidence

HTTP_TIMEOUT_S=5
LOG_LEVEL=info
