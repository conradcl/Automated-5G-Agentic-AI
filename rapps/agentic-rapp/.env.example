# Bind addresses are local by default. In containers, advertise service DNS
# names with the *_BASE_URL variables while binding to 0.0.0.0.
DME_BIND_HOST=127.0.0.1
DME_PORT=9990
DME_BASE_URL=http://127.0.0.1:9990
# Direct Evidence API origin used by readiness/history tools; no path or query.
EVIDENCE_API_BASE_URL=http://127.0.0.1:9991
INFO_TYPE_ID=oran-health-monitor-kpm-v1
JOB_ID=health-agent-rapp-job-1
JOB_OWNER=health-agent-rapp

CONSUMER_BIND_HOST=127.0.0.1
CONSUMER_PORT=9992
CONSUMER_BASE_URL=http://127.0.0.1:9992
CONSUMER_CALLBACK_PATH=/consumer/health-data
CONSUMER_MAX_BODY_BYTES=262144

STALE_AFTER_S=30
REQUIRED_KPM_METRICS=RRU.PrbTotDl,RRU.PrbTotUl,DRB.UEThpDl,DRB.UEThpUl,DRB.RlcSduDelayDl

# Optional DeepSeek evidence explanation. Leave the key empty to use the
# deterministic prose fallback without making an external API request.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_TIMEOUT_S=20
DEEPSEEK_MAX_TOKENS=1200
# If DeepSeek returns finish_reason=length, retry once with at most this many
# output tokens. Existing .env files can omit this and use the default.
DEEPSEEK_TRUNCATION_RETRY_MAX_TOKENS=2400
DEEPSEEK_MAX_QUESTION_CHARS=2000
DEEPSEEK_MAX_INPUT_CHARS=50000

# Model-selected read-only evidence tools. Active selection requires DeepSeek.
# Set false to keep the existing explanation-only path. The model selects only
# fixed zero-argument tools; all network/process targets are operator-owned.
RAPP_READ_TOOLS_ENABLED=true
# Maximum distinct sequential tools per question; valid range 1..7.
RAPP_READ_TOOL_MAX_CALLS=4
RAPP_READ_TOOL_PLANNER_MAX_TOKENS=500
RAPP_READ_TOOL_HTTP_TIMEOUT_S=3
# Per-response HTTP body cap and per-result model-boundary cap.
RAPP_READ_TOOL_HTTP_MAX_BODY_BYTES=131072
RAPP_READ_TOOL_MAX_RESULT_CHARS=30000
RAPP_READ_TOOL_HISTORY_LIMIT=20
RAPP_READ_TOOL_WINDOW_LIMIT=3
# Shared raw-sample budget for all requested windows; valid range 1..10000.
RAPP_READ_TOOL_WINDOW_MAX_SAMPLES=2000
# Shared stored-JSON read budget for those windows; valid range 65536..50000000.
RAPP_READ_TOOL_WINDOW_MAX_BYTES=4000000
RAPP_READ_TOOL_SEQUENCE_LOOKBACK_S=60
RAPP_READ_TOOL_SEQUENCE_MAX_SAMPLES=600
# Fixed operator-owned active-probe destination. Target must be a literal IP;
# ping count is 1..10. The model cannot replace any of these values.
RAPP_READ_TOOL_PING_TARGET=192.168.70.135
RAPP_READ_TOOL_PING_INTERFACE=oaitun_ue1
RAPP_READ_TOOL_PING_COUNT=3
RAPP_READ_TOOL_PING_REPLY_TIMEOUT_S=1
RAPP_READ_TOOL_COMMAND_TIMEOUT_S=8
# One to sixteen unique names. Docker daemon access is privileged even though
# the rApp invokes only a fixed container-inspect operation.
RAPP_READ_TOOL_OAI_CONTAINERS=oai-nrf,oai-amf,oai-smf,oai-upf,oai-ext-dn,mysql

# Durable, structured rApp memory. This is SQLite, not a telemetry text/log
# file. Use an absolute path when the rApp runs under a service manager.
RAPP_MEMORY_ENABLED=true
RAPP_MEMORY_DB_PATH=./data/rapp_memory.sqlite3
RAPP_DEFAULT_THREAD_ID=health-agent-cli
RAPP_CONVERSATION_CONTEXT_TURNS=8
RAPP_CONVERSATION_RETAINED_TURNS=100
RAPP_MEMORY_MAX_CONTEXT_CHARS=30000
RAPP_MEMORY_MAX_ADVISORY_CHARS=4000

# One-second xApp deliveries are grouped into time windows. A 60-second window
# may contain fewer than 60 samples when delivery is delayed or interrupted.
TELEMETRY_MEMORY_WINDOW_S=60
TELEMETRY_MEMORY_WINDOW_CLOSE_GRACE_S=1
TELEMETRY_MEMORY_POLL_S=1
TELEMETRY_MEMORY_INGEST_QUEUE_SIZE=1000
TELEMETRY_MEMORY_CONTEXT_WINDOWS=1
TELEMETRY_MEMORY_MAX_SAMPLES_PER_PAYLOAD=120
TELEMETRY_MEMORY_MAX_PAYLOAD_CHARS=30000
TELEMETRY_MEMORY_RAW_RETENTION_HOURS=24
TELEMETRY_MEMORY_RETAINED_WINDOWS=1440
TELEMETRY_MEMORY_SUMMARY_MAX_TOKENS=800
TELEMETRY_MEMORY_MAX_DIGEST_CHARS=8000
