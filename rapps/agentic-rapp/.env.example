# Bind addresses are local by default. In containers, advertise service DNS
# names with the *_BASE_URL variables while binding to 0.0.0.0.
DME_BIND_HOST=127.0.0.1
DME_PORT=9990
DME_BASE_URL=http://127.0.0.1:9990
INFO_TYPE_ID=oran-health-monitor-kpm-v1

CONSUMER_BIND_HOST=127.0.0.1
CONSUMER_PORT=9992
CONSUMER_BASE_URL=http://127.0.0.1:9992
CONSUMER_MAX_BODY_BYTES=262144

STALE_AFTER_S=30
REQUIRED_KPM_METRICS=RRU.PrbTotDl,RRU.PrbTotUl,DRB.UEThpDl,DRB.UEThpUl,DRB.RlcSduDelayDl

# Optional DeepSeek evidence explanation. Leave the key empty to use the
# deterministic prose fallback without making an external API request.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_TIMEOUT_S=20
DEEPSEEK_MAX_TOKENS=600
DEEPSEEK_MAX_QUESTION_CHARS=2000
DEEPSEEK_MAX_INPUT_CHARS=50000

# Durable, structured rApp memory. This is SQLite, not a telemetry text/log
# file. Use an absolute path when the rApp runs under a service manager.
RAPP_MEMORY_ENABLED=true
RAPP_MEMORY_DB_PATH=./data/rapp_memory.sqlite3
RAPP_DEFAULT_THREAD_ID=health-agent-cli
RAPP_CONVERSATION_CONTEXT_TURNS=8
RAPP_CONVERSATION_RETAINED_TURNS=100
RAPP_MEMORY_MAX_CONTEXT_CHARS=30000
RAPP_MEMORY_MAX_ADVISORY_CHARS=4000

# One-second xApp deliveries are grouped into time windows. A 60-second window
# may contain fewer than 60 samples when delivery is delayed or interrupted.
TELEMETRY_MEMORY_WINDOW_S=60
TELEMETRY_MEMORY_WINDOW_CLOSE_GRACE_S=1
TELEMETRY_MEMORY_POLL_S=1
TELEMETRY_MEMORY_INGEST_QUEUE_SIZE=1000
TELEMETRY_MEMORY_CONTEXT_WINDOWS=1
TELEMETRY_MEMORY_MAX_SAMPLES_PER_PAYLOAD=120
TELEMETRY_MEMORY_MAX_PAYLOAD_CHARS=30000
TELEMETRY_MEMORY_RAW_RETENTION_HOURS=24
TELEMETRY_MEMORY_RETAINED_WINDOWS=1440
TELEMETRY_MEMORY_SUMMARY_MAX_TOKENS=300
TELEMETRY_MEMORY_MAX_DIGEST_CHARS=8000
